<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Уведомления о невыполненных целях. С Android 13 разрешение
         спрашивается в рантайме — это делает NotificationService. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Резервные копии пишутся в общую папку `TexFi Backup` во внутреннем
         хранилище, а не в песочницу приложения, — так копия переживает
         удаление самого приложения. До Android 11 для публичной папки
         достаточно этих двух (см. BackupStorageChannel); maxSdkVersion=28
         оставлен по той же причине, что и remove ниже: на 29-м уже действует
         scoped storage, и разрешение там ничего не даёт без отдельного флага
         совместимости, а поднимать его ради переходной версии не стоит —
         основной путь на новых устройствах идёт через
         MANAGE_EXTERNAL_STORAGE. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:replace="android:maxSdkVersion" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:replace="android:maxSdkVersion" />
    <!-- Android 11+ (API 30): единственный способ читать и писать
         произвольную папку внутреннего хранилища вне песочницы приложения.
         Выдаётся не диалогом, а отдельным системным экраном — приложение
         показывает объяснение перед первым переходом на него (см. экран
         импорта/бэкапов), а не открывает его без предупреждения. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Напоминания должны переживать перезагрузку устройства. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Вибрация: кастомные паттерны mood-переключателя и таймера. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Конец фокус-сессии должен срабатывать секунда в секунду. Без точного
         будильника система в Doze откладывает срабатывание до ближайшего
         окна — на практике это минуты, и «время вышло» приходит тогда, когда
         человек уже давно встал. SCHEDULE_EXACT_ALARM спрашивается в
         рантайме (API 31+), USE_EXACT_ALARM выдаётся сразу и покрывает
         API 33+ как раз для будильников и таймеров. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Приложение раздаётся .apk через GitHub Releases, магазина у него нет:
         обновиться можно только скачав пакет и отдав его системному
         установщику. Само оно ничего не устанавливает — разрешение лишь
         позволяет показать штатный диалог установки, а согласие на установку
         из этого источника Android спрашивает отдельно и каждый раз сам.

         Для Google Play это разрешение пришлось бы убрать (политика магазина
         запрещает самообновление в обход него) — но туда приложение и не
         публикуется.

         Файл установщику отдаётся через FileProvider, объявленный самим
         open_filex (авторитет `${applicationId}.fileProvider.com.crazecoder.openfile`,
         пути — в его `@xml/filepaths`, куда входит cache-path, то есть ровно
         то, что возвращает getTemporaryDirectory()). Свой провайдер здесь не
         объявляется намеренно: второй с тем же именем ломает слияние
         манифестов, а нужды в нём нет. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Тишина на время фокус-сессии. Разрешение только объявляет намерение:
         доступ к «Не беспокоить» выдаётся не диалогом, а вручную на системном
         экране, и без него вызов setInterruptionFilter просто не сработает.
         Режим включается по явной настройке, снимается по концу сессии, а
         прежний фильтр возвращается ровно тот, что был. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:label="TexFi f0kus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Открытие папки `TexFi Backup` в системном «Файлы» (см.
             BackupStorageChannel.openBackupFolder) и выбор файла бэкапа при
             импорте (пакет file_picker) — оба идут implicit-интентами, и с
             API 30 их обработчики нужно объявить явно, иначе
             PackageManager вернёт пустой список ещё до попытки открыть. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="vnd.android.document/directory"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="application/json"/>
        </intent>
    </queries>
</manifest>
